{
  "name": "easycnc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pilotage web (Web Serial) d'une CNC sous GRBL",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vitest run && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:install": "playwright install chromium",
    "test": "vitest run"
  },
  "dependencies": {
    "clipper-lib": "^6.4.2",
    "jszip": "^3.10.2",
    "opentype.js": "^1.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@types/w3c-web-serial": "^1.0.6",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^2.1.9"
  }
}
